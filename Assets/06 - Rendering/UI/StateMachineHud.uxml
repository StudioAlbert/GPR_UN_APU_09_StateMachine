<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="/Assets/06 - Rendering/UI/StateMachineHud.uss" />

    <!-- picking-mode Ignore partout : le HUD ne vole aucun clic aux boutons du Canvas. -->
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">

        <ui:VisualElement name="top" class="hud__top" picking-mode="Ignore">

            <ui:VisualElement name="left" class="hud__column" picking-mode="Ignore">
                <ui:Label name="context" text="context" class="box box--context" picking-mode="Ignore" />
                <ui:Label name="controls" text="controls" class="box box--controls" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="right" class="hud__column hud__column--right" picking-mode="Ignore">
                <ui:Label name="state-name" text="State name" class="box box--state" picking-mode="Ignore" />
                <ui:Label name="state-details" text="Details" class="box box--details" picking-mode="Ignore" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
